# Copy to .env and change the placeholder values. .env is gitignored (design rule 11).

# Postgres container credentials, read by docker compose
POSTGRES_USER=flashsale
POSTGRES_PASSWORD=change-me
POSTGRES_DB=flashsale

# Connection strings for Node apps running on the host during development.
# They reach the containers through the ports published in docker-compose.override.yml.
DATABASE_URL=postgresql://flashsale:change-me@localhost:5432/flashsale
REDIS_URL=redis://localhost:6379

# API
PORT=3000
