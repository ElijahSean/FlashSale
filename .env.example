# Copy to .env and change the placeholder values. .env is gitignored (design rule 11).

# Postgres container credentials, read by docker compose
POSTGRES_USER=flashsale
POSTGRES_PASSWORD=change-me
POSTGRES_DB=flashsale

# Connection strings for Node apps running on the host during development.
# They reach the containers through the ports published in docker-compose.override.yml.
DATABASE_URL=postgresql://flashsale:change-me@localhost:5432/flashsale
REDIS_URL=redis://localhost:6379

# API
PORT=3000

# Sale window and stock (design rule 12: one product, from config).
# Seeded into Redis on first boot only. To apply changed values later, reset the sale keys
# (see CLAUDE.md). Times are ISO 8601 with a timezone.
SALE_STARTS_AT=2026-09-24T00:00:00Z
SALE_ENDS_AT=2026-12-31T23:59:59Z
SALE_STOCK=100

# Product shown on the page. Price is a display string only; there are no payments.
PRODUCT_NAME=Limited Edition Sneaker
PRODUCT_PRICE='$99.00'
# Optional. The web app serves this file from apps/web/public; leave empty for a plain placeholder.
PRODUCT_IMAGE_URL=/images/product.svg

# Demo login (requirement 05). Signs the JWTs, so it must stay secret: at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters

# The web app's address. CORS lets only this origin call the API from a browser.
WEB_ORIGIN=http://localhost:5173

# Rate limits, requests per second (fixed 1 s window, counted in Redis). The stress runs raise them
# in docker-compose.stress.yml, because all k6 traffic comes from one address.
RATE_LIMIT_USER_PER_SEC=5
RATE_LIMIT_IP_PER_SEC=50

# Test-only reset route, POST /api/admin/reset (requirement 07). Off unless exactly "true";
# docker-compose.stress.yml turns it on for the stress runs. The token goes in the X-Admin-Token
# header and must be at least 32 characters. Generate one the same way as JWT_SECRET.
ENABLE_ADMIN=false
ADMIN_TOKEN=replace-with-another-random-string-of-at-least-32-characters

# Web app (read by Vite from this file). Empty means same origin: the Vite dev server forwards
# /api to the API on port 3000, and nginx does the same in the full stack. Only VITE_* variables
# reach the browser, so nothing above this line is ever exposed.
VITE_API_BASE_URL=
