// The one database schema. `prisma generate` makes a client for the API and one for the worker,
// so they always agree.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  // No '.js' in generated imports: Jest can't handle them.
  importFileExtension = ""
}

generator worker {
  provider     = "prisma-client"
  output       = "../../worker/src/generated/prisma"
  moduleFormat = "cjs"
  // No '.js' in generated imports: Jest can't handle them.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

model Order {
  // Random UUID, so ids don't reveal how many orders exist. Postgres makes it,
  // so the worker's raw INSERT gets an id without sending one.
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Rule 2: one order per user, for good. Redis checks it during the sale;
  // this is the backup if Redis data is ever lost.
  userId    String   @unique
  createdAt DateTime @default(now())

  // "order" is a reserved word in SQL, so the table is "orders".
  @@map("orders")
}
