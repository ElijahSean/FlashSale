// Single source of truth for the database. One `prisma generate` writes a client for the API
// and one for the worker (04), so the two can never disagree about the schema.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  // No '.js' on imports between generated files: Jest (ts-jest) cannot map them to the .ts
  // files. Left unset, Prisma picks the extension itself, and it picked '.js'.
  importFileExtension = ""
}

generator worker {
  provider     = "prisma-client"
  output       = "../../worker/src/generated/prisma"
  moduleFormat = "cjs"
  // No '.js' on imports between generated files: Jest (ts-jest) cannot map them to the .ts
  // files. Left unset, Prisma picks the extension itself, and it picked '.js'.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

model Order {
  // UUID, not autoincrement, so ids do not reveal how many orders exist. Generated by
  // Postgres, not by Prisma, so the worker's raw INSERT ... ON CONFLICT DO NOTHING
  // (design rule 5, requirement 04) gets an id without supplying one.
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Design rule 2: the permanent one-per-user guarantee. Redis sale:buyers enforces it during
  // the sale; this constraint is the backstop that survives a Redis loss.
  userId    String   @unique
  createdAt DateTime @default(now())

  // "order" is a reserved word in SQL; a plain table name avoids quoting everywhere.
  @@map("orders")
}
