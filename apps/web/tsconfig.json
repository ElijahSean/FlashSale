{
  // Not extending tsconfig.base.json: that one targets Node (node16 modules, decorators).
  // The browser app is bundled by Vite, so it uses bundler resolution and React's JSX.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "@testing-library/jest-dom/vitest"]
  },
  "include": ["src", "vite.config.ts"]
}
