{
  // Type checking only for verify.ts. Node runs it directly by stripping the types, so only
  // syntax that can simply be erased is allowed (no enums, no namespaces).
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": ["verify.ts"]
}
